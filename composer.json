{
    "name": "multicoin/api-client",
    "description": "its a packages for multicoin api",
    "keywords": ["cryptocurrency", "multicoin-client"],
    "homepage": "https://github.com/minulislam/multicoin-api",
    "license": "MIT",
    "authors": [
        {
            "name": "shahan khan",
            "email": "17300521+minulislam@users.noreply.github.com",
            "homepage": "https://multicoin.test",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "guzzlehttp/promises": "^2.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "php-http/client-common": "^2.7",
        "php-http/discovery": "^1.19",
        "php-http/guzzle7-adapter": "^1.0",
        "php-http/httplug": "^2.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "php-http/mock-client": "^1.6",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "conflict": {
        "guzzlehttp/guzzle": "<7.0"
    },
    "autoload": {
        "psr-4": {
            "Multicoin\\Api\\": "src/"
        },
         "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Multicoin\\Api\\Tests\\": "tests/"
        }
    },

    "scripts": {
        "test": "vendor/bin/phpunit",
        "fixer": "php-cs-fixer fix"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Multicoin\\Api\\MulticoinServiceProvider"],
            "aliases": {
                "Multicoin": "Multicoin\\Api\\Facade\\Multicoin"
            }
        }
    },
    "prefer-stable": true,
    "minimum-stability": "stable"
}
